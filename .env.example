# LLM Provider
OPENAI_API_KEY=sk-your-openai-key-here

# LangSmith Tracing (Optional)
LANGCHAIN_API_KEY=ls-your-langsmith-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=llm-observability-pipeline

# Langfuse (Optional)
LANGFUSE_PUBLIC_KEY=lf-your-public-key
LANGFUSE_SECRET_KEY=lf-your-secret-key
